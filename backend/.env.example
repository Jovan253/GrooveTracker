# Copy to backend/.env for running the backend outside docker compose.

PORT=3000
DATABASE_URL=postgres://groovetracker:changeme@localhost:5432/groovetracker

# Optional. Set this to the frontend's origin (e.g. what `vite dev` prints,
# commonly http://localhost:5173) to let browser requests from the app
# reach this API — see src/index.js for why. Leave unset if you're only
# hitting the API with curl/Postman/etc, which don't enforce CORS anyway.
CORS_ORIGIN=http://localhost:5173
