# Top-level vars for docker-compose.yml. Copy to `.env` and adjust locally;
# `.env` is gitignored.

# Postgres — consumed directly by the db service, and combined into
# DATABASE_URL for the backend service.
POSTGRES_USER=groovetracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=groovetracker
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000

# Frontend (host port; the container always serves on :80 via nginx)
FRONTEND_PORT=5173
